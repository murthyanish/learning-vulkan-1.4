{
  "version": 4,
  "configurePresets": [
    {
      "name": "base",
      "displayName": "Base Config",
      "description": "Base build with required cache variables to run the projects",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "ENABLE_CPP23_MODULE": "ON",
        "LVULKAN_SDL_VENDORED": "ON",
        "SDL_X11_XSCRNSAVER": "OFF"
      },
      "environment": {
        "VULKAN_SDK": "$env{HOME}/vulkan/1.4.363.0/x86_64"
      }
    },
    {
      "name": "debug",
      "description": "Debug build with metadata",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "description": "Optimized release build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ]
}
